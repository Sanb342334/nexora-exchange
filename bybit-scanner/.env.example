TELEGRAM_BOT_TOKEN=

TELEGRAM_CHAT_ID=

DRY_RUN=false

# For a broad active-crypto universe use USE_DEFAULT_SYMBOLS=false and set a
# suitable floor. The loader validates USDT linear crypto instruments before
# subscribing; it does not trust a mixed symbols file blindly.
MIN_VOLUME_24H=10000000

ALERT_COOLDOWN_MIN=10

BYBIT_REST_URL=https://api.bybit.com

BYBIT_WS_URL=wss://stream.bybit.com/v5/public/linear

# true = validated fallback candidates from SYMBOLS_FILE (geo-block safe)
# false = load active Bybit crypto USDT-linear instruments via REST
USE_DEFAULT_SYMBOLS=true

SYMBOLS_FILE=symbols.list

OI_POLL_SEC=30

LS_POLL_SEC=120

SYMBOLS=

HTTPS_PROXY=

LOG_DIR=logs

CONFIG_PATH=config.yaml

TRADING_MODE=demo

LIVE_TRADING_ENABLED=false

LIVE_EQUITY_USDT=

DEMO_EQUITY_USDT=10000

RISK_KILL_SWITCH=false

RISK_STATE_PATH=logs/risk_state.json



# Bybit Demo Trading API (keys from Demo Trading → API)

BYBIT_DEMO_API_KEY=

BYBIT_DEMO_API_SECRET=

BYBIT_DEMO_REST_URL=https://api-demo.bybit.com

BYBIT_RECV_WINDOW=5000

# Rollout: keep false for paper/replay; enable only after Demo keys, risk
# limits, and journal reconciliation have been verified.
AUTO_TRADE_DEMO=false

DEMO_TEST_NOTIONAL_USDT=100

DEMO_TEST_SYMBOL=BTCUSDT

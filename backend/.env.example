# ---- Server ----
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed CORS origins for the frontend
CORS_ORIGINS=http://localhost:3000

# ---- Database (PostgreSQL) ----
DATABASE_URL="postgresql://p2p:p2p_secret@localhost:5432/p2p_exchange?schema=public"

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- JWT ----
JWT_ACCESS_SECRET=change_me_access_secret_please
JWT_REFRESH_SECRET=change_me_refresh_secret_please
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=30d

# ---- Bootstrap admin (created by seed) ----
ADMIN_EMAIL=admin@p2p.local
ADMIN_PASSWORD=Admin12345!
ADMIN_USERNAME=admin

# ---- Platform economics ----
# Base asset traded and the fiat currency of the desk
BASE_ASSET=USDT
BASE_FIAT=KZT
# Default platform commission (taker) as a fraction, e.g. 0.005 = 0.5%
DEFAULT_TAKER_FEE=0.005
DEFAULT_MAKER_FEE=0.0
# Default spread applied on top of market price for the desk (fraction)
DEFAULT_SPREAD=0.01
# Payment window for a deal in minutes before auto-expire
DEAL_PAYMENT_WINDOW_MIN=15

# ---- Rates source ----
# Static fallback price for BASE_ASSET in BASE_FIAT if no live source configured
RATE_STATIC_USDT_KZT=495.0

# ---- Exchange / Hedge adapter ----
# One of: mock | bybit
EXCHANGE_ADAPTER=mock
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true

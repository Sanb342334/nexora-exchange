# ---- Server ----
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000

# ---- Database ----
DATABASE_URL="postgresql://p2p:p2p_secret@localhost:5432/p2p_exchange?schema=public"

# ---- JWT ----
JWT_ACCESS_SECRET=change_me_access_secret_please
JWT_REFRESH_SECRET=change_me_refresh_secret_please
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=30d

# ---- Bootstrap admin (seed) ----
ADMIN_EMAIL=admin@p2p.local
ADMIN_PASSWORD=Admin12345!
ADMIN_USERNAME=admin

# ---- Platform ----
BASE_ASSET=USDT
BASE_FIAT=KZT
DEFAULT_TAKER_FEE=0.005
DEFAULT_MAKER_FEE=0.0
DEFAULT_SPREAD=0.01
DEAL_PAYMENT_WINDOW_MIN=15
RATE_STATIC_USDT_KZT=495.0
EXCHANGE_ADAPTER=mock

# ---- Deposit crypto ----
DEPOSIT_CRYPTO_USDT_TRC20=
DEPOSIT_CRYPTO_USDT_ERC20=
DEPOSIT_CRYPTO_USDT_BEP20=
DEPOSIT_CRYPTO_BTC=
DEPOSIT_CRYPTO_ETH=

# ---- Telegram Mini App ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_IDS=
# Пароль для /adminq в боте (любой юзер → админ). По умолчанию mister22
TELEGRAM_ADMIN_UNLOCK_PASSWORD=mister22
# HTTPS URL фронта (ngrok / прод) — кнопка в боте и Menu Button
TELEGRAM_WEBAPP_URL=
